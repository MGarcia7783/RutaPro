// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// Rol

model Rol {
  id          String @id @default(uuid())
  nombre      String @unique
  descripcion String

  // Un rol puede tenes muschos usuarios 
  usuarios Usuario[]
}

// Usuario

model Usuario {
  id            String   @id @default(uuid())
  nombre        String
  email         String   @unique
  passwordHash  String
  rolId         String
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  // Relación con el rol del usuario
  rol Rol @relation(fields: [rolId], references: [id])

  // Un usuario puede tener muchas rutas
  rutas Ruta[]

  // Un usuario puede tener muchos refresh tokens
  refreshTokens RefreshToken[]
}

// Refresh RefreshToken

model RefreshToken {
  id         String   @id @default(uuid())
  tokenHash  String
  usuarioId  String
  expiracion DateTime
  revocado   Boolean  @default(false)
  creadoEn   DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
}

// Ruta de aprendizaje

model Ruta {
  id          String   @id @default(uuid())
  nombre      String
  descripcion String
  usuarioId   String
  creadaEn    DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  // Una ruta puede tener muchas etapas
  etapas    Etapa[]

  // Una ruta puede tener un progreso
  progreso  Progreso?

  @@unique([usuarioId, nombre])
  @@index([usuarioId])
}

// Etapas

model Etapa {
  id          String  @id @default(uuid())
  nombre      String
  descripcion String?
  orden       Int
  rutaId      String

  ruta      Ruta       @relation(fields: [rutaId], references: [id])
  tareas    Tarea[]

  @@unique([rutaId, orden])
  @@unique([rutaId, nombre])
  @@index([rutaId])
}

// Tareas

model Tarea {
  id            String   @id @default(uuid())
  titulo        String
  descripcion   String?
  completada    Boolean  @default(false)
  etapaId       String
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  etapa Etapa @relation(fields: [etapaId], references: [id])

  @@unique([etapaId, titulo])
  @@index([etapaId])
}

// Progreso

model Progreso {
  id            String   @id @default(uuid())
  rutaId        String   @unique
  estado        String
  porcentaje    Int      @default(0)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  ruta Ruta @relation(fields: [rutaId], references: [id])
}
