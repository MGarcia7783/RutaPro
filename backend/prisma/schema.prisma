// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// Rol

model Rol {
  id          String  @id @default(uuid())
  nombre      String  @unique
  descripcion String  

  usuarios Usuario[]
}

// Usuario

model Usuario {
  id              String    @id @default(uuid())
  nombre          String
  email           String    @unique
  passwordHash    String
  rolId           String
  activo          Boolean   @default(true)
  creadoEn        DateTime  @default(now())
  actualizadoEn   DateTime  @updatedAt

  // Relación con el rol del usuario
  rol Rol @relation(fields: [rolId], references: [id])

  // Objetivos pertenecientes al usuario
  objetivos Objetivo[]

  // Progresos registrados por el usuario
  progresos Progreso[]

  // Refresh token del usuario
  refreshTokens RefreshToken[]
}


// Refresh RefreshToken

model RefreshToken {
  id              String    @id @default(uuid())
  tokenHash       String
  usuarioId       String
  expiracion      DateTime
  revocado        Boolean   @default(false)
  creadoEn        DateTime  @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
}

// Ruta de aprendizaje

model Ruta {
  id          String    @id @default(uuid())
  nombre      String    @unique
  descripcion String
  creadaEn    DateTime  @default(now())

  progresos Progreso[]
  objetivos ObjetivoRuta[]
}

// Objetivos

model Objetivo {
  id              String    @id @default(uuid())
  titulo          String
  descripcion     String?
  completado      Boolean   @default(false)
  usuarioId       String
  creadoEn        DateTime  @default(now())
  actualizadoEn   DateTime  @updatedAt

  // Relación con el usuario propietario
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  // Relación con las rutas
  rutas ObjetivoRuta[]

  // Índice para facilitar las consultas
  @@index([usuarioId])

  // Un usuario no puede tener dos objetivos con el mismo título
  @@unique([usuarioId, titulo])
}

// Entidad asociativa entre Objetivo y Ruta

model ObjetivoRuta {
  objetivoId    String
  rutaId        String

  objetivo  Objetivo  @relation(fields: [objetivoId], references: [id])
  ruta      Ruta      @relation(fields: [rutaId], references: [id])

  // Crear clave primaria compuesta
  @@id([objetivoId, rutaId])
}

// Progreso

model Progreso {
  id            String    @id @default(uuid())
  estado        String
  porcentaje    Int       @default(0)
  usuarioId     String
  rutaId        String
  creadoEn      DateTime  @default(now())
  actualizacion DateTime  @updatedAt

  usuario Usuario @relation(fields: [usuarioId], references: [id])
  ruta    Ruta    @relation(fields: [rutaId], references: [id])

  @@unique([usuarioId, rutaId])
}